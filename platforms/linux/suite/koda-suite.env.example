# Suite/gateway overrides only. Keep database credentials, image references,
# Compose project identity, and volume names in .env.
PUBLIC_HTTP_PORT=8088
GATEWAY_SERVER_NAME=_
TRACKER_SECURE_COOKIES=true
KODA_BASE_PATH=/koda/
KODA_DASHBOARD_BIND=127.0.0.1
KODA_PORT=8765
KODA_PUBLISH_DASHBOARD=0
KODA_DASHBOARD_NETWORK=koda-dashboard
KODA_PORTAL_UPSTREAM=koda-dashboard:8765
TRACKER_SESSION_UPSTREAM=portal-api:8000

# Production must terminate TLS before this gateway and preserve HTTPS.
# TRACKER_ENVIRONMENT=development is the only loopback/plain-HTTP exception.
TRACKER_ENVIRONMENT=production
TRACKER_PUBLIC_ORIGIN=https://koda.example.internal
GATEWAY_PUBLIC_SCHEME=https
DTRACK_API_BASE_URL=https://koda.example.internal/dependency-track
DTRACK_ADMIN_API_BASE_URL=https://koda.example.internal/dependency-track/api
APP_NETWORK_SUBNET=172.30.80.0/24
GATEWAY_APP_IP=172.30.80.10
TRACKER_TRUSTED_PROXY_CIDRS=172.30.80.10/32

KODA_SSBOM_TRACKER_URL=/
KODA_CPUS=2
KODA_MEMORY=4g
KODA_PIDS_LIMIT=256
KODA_TMPFS_SIZE=512m
