{
  "targets": [
    {
      "name": "security-workspace",
      "path": ".",
      "categories": ["secrets", "dependencies", "configuration", "code", "prevention"],
      "exclude_globs": [
        "**/.git/**",
        "**/node_modules/**",
        "**/.venv/**",
        "**/venv/**",
        "**/dist/**",
        "**/build/**",
        "**/.next/**",
        "**/reports/**",
        "**/.omx/**",
        "**/.playwright-cli/**",
        "**/output/**"
      ],
      "max_file_size_bytes": 524288
    }
  ],
  "enable_osv": false,
  "enable_vuln_intel": false,
  "report": {
    "format": "html",
    "output": "reports/security-dashboard.html",
    "min_severity": "low",
    "language": "ko"
  }
}
